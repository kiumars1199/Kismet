# --- Lane E+K (extension + Kalshi paper trading) ---
# "demo" turns on the paper-trading ticket against Kalshi's DEMO exchange. Leave empty in production.
KALSHI_TRADING_ENV=
# Comma-separated emails allowed to see the Trade ticket when DEMO_MODE=false.
TRADING_ALLOWLIST=
# 32+ random characters. Signs extension sign-in tokens and one-time order nonces. Required when DEMO_MODE=false.
EXT_SIGNING_SECRET=
# Chrome Web Store extension ID (empty = the pinned dev ID cgoaaiaghbckpalppklocajbdpoelmbd).
NEXT_PUBLIC_EXTENSION_ID=
# Optional, e2e only (apps/web/.env.local): a Kalshi DEMO key with read + write::trade, to run trading-paper against the real demo exchange.
KALSHI_DEMO_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=
KALSHI_DEMO_TICKER=
NEXT_PUBLIC_EXTENSION_STORE_URL=
