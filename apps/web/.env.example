# Demo: no auth, no billing, tier forced to premium, user data in localStorage.
DEMO_MODE=true
# local = read JSON from DATA_DIR; github = `live` branch via the GitHub contents API
DATA_SOURCE=local
# Empty = ../../output (relative to apps/web). Tests and e2e use test/fixtures.
DATA_DIR=
# Only for DATA_SOURCE=github
GITHUB_DATA_TOKEN=
GITHUB_DATA_REPO=kiumars1199/marketedge
GITHUB_DATA_REF=live
