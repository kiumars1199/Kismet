# Demo: no auth, no billing, tier forced to premium. Only `true` turns it on; unset = on for pnpm dev, OFF in a production build.
DEMO_MODE=true
# local = read JSON from DATA_DIR; github = `live` branch via the GitHub contents API; supabase = private bucket (production)
DATA_SOURCE=local
# Empty = ../../output (relative to apps/web). Tests and e2e use test/fixtures.
DATA_DIR=
# Only for DATA_SOURCE=github
GITHUB_DATA_TOKEN=
GITHUB_DATA_REPO=kiumars1199/marketedge
GITHUB_DATA_REF=live

# --- Lane O (ops) ---
# DATA_SOURCE above also takes `supabase`: private Storage bucket `scan` → GitHub `live` branch → last good copy.
# Shared with the accounts lane: server reads the bucket and checks the DB with these two.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public site origin for links in emails, e.g. https://marketedge.example (no trailing slash)
NEXT_PUBLIC_SITE_URL=
# Vercel Cron bearer secret for /api/alerts/run and /api/settle/run (openssl rand -hex 32)
CRON_SECRET=
# /api/health turns 503 when a remote scan is older than this many minutes
HEALTH_MAX_DATA_AGE_MIN=30
# Errors (Sentry); empty = off
NEXT_PUBLIC_SENTRY_DSN=
# Analytics (PostHog, cookieless); empty = off
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Alert email (Resend); empty = no email sent
RESEND_API_KEY=
EMAIL_FROM=
# Signs one-click unsubscribe links (openssl rand -hex 32)
UNSUBSCRIBE_SECRET=
# Engine container only (Railway/Fly), not Vercel: SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, BACKTEST_HOUR_UTC=6

# --- Lane L (accounts, billing) ---
# Supabase Auth: NEXT_PUBLIC_SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are in the Lane O block above.
# Anon (public) key: Supabase > Project settings > API. Empty URL or key = accounts off.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Not read: next.config sets the browser flag from DEMO_MODE (unset DEMO_MODE = off in a production build).
NEXT_PUBLIC_DEMO_MODE=
# Stripe (test keys first). Empty = pricing buttons show "Coming soon".
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
# Optional fixed Customer Portal login link (Payment Links mode); empty = a portal session per user.
STRIPE_PORTAL_URL=
# Dev/e2e only, ignored when NODE_ENV=production: Stripe SDK at the in-app mock, and the mock routes on.
STRIPE_API_BASE=
E2E_MOCK=
# Trading terms on /terms appear when KALSHI_TRADING_ENV (repo-root .env.example, Lane E+K) is set.
